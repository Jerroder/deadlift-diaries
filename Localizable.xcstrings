      "comment" : "A number representing the number of sets for an exercise.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "%lld x %@" : {
      "comment" : "A subtext that displays the target sets and value for a workout exercise. The argument is the string “%arg”, the string “%args”, the string “%argm”, the string “%1$argm %2$args” or the string “%1$arg %2$arg”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld x %2$@"
