    "  %llds " : {
      "comment" : "A text field displaying the current rest duration in seconds. The text inside the field is dynamically updated based on the `restDuration` state variable.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    " %llds" : {
      "comment" : "A label displaying the duration of the next exercise in seconds. The argument is the duration of the next exercise in seconds.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
