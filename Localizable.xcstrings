      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Name, um Vorlagen zu gruppieren, damit deren Übungsverlauf getrennt von anderen Programmen verfolgt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just a name to group templates under, so their exercise history is tracked separately from other programs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
